@startuml UC_Auth
autoactivate on
actor "Регистратура" as a
participant "Система" as s
database "БД" as db
activate a
a -> s: Ввести логин и пароль
s -> db: Проверить учётные данные
s <-- db: Результат
autoactivate off
alt успешно
  a <-- s: Открыть личный кабинет
else ошибка
  a <-- s: Показать сообщение об ошибке
end
deactivate s
@enduml

