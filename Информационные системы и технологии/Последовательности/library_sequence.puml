@startuml UC_Auth
autoactivate on
actor "Пользователь" as a
participant "Система" as s
database "БД" as db
activate a
a -> s: Ввести логин и пароль
s -> db: Проверить учётные данные
s <-- db: Результат
autoactivate off
alt успешно
  a <-- s: Открыть кабинет
else ошибка
  a <-- s: Показать ошибку
end
deactivate s
@enduml

